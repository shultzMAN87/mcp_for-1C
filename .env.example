# ═══════════════════════════════════════════════════════════════════
#  1C MCP Suite — переменные окружения
#  Скопировать в .env и заполнить. .env в репозиторий не попадает.
# ═══════════════════════════════════════════════════════════════════

# ─── Аутентификация MCP (SEC-3) ────────────────────────────────────
# Общий секрет для всех серверов. Пусто => серверы НЕ стартуют.
# Раньше пустое значение просто отключало проверку, а порты при этом
# публиковались на 0.0.0.0 — то есть открытый стек с warning'ом в логе.
# Сгенерировать:
#   Linux/macOS: openssl rand -hex 32
#   Windows:     python -c "import secrets;print(secrets.token_hex(32))"
# Этот же секрет прописывается в .cursor/mcp.json.
MCP_SHARED_SECRET=

# ─── Neo4j (SEC-1, SEC-2) ──────────────────────────────────────────
# Единое имя переменной во всём проекте — NEO4J_PASSWORD.
# NEO4J_PASS в коде больше не используется (читается только как legacy).
# Дефолта "password1c" тоже больше нет: без пароля сервер не стартует.
#
# ВАЖНО: прежний пароль лежал в 1c-mcp-suite/README.md и остался в
# истории git. Удалить строку недостаточно — пароль надо СМЕНИТЬ в Neo4j.
NEO4J_PASSWORD= 

# ─── Пути (FIX-1) ──────────────────────────────────────────────────
# Настоящая XML-выгрузка конфигурации. Каталог ./1c-config-xml больше
# не монтируется в bsl-checker: там лежит только ОтчетПоКонфигурации.txt,
# и bsl_check_directory анализировал пустоту.
#
# SRC-2. WORKSPACE_DIR — корень РЕПОЗИТОРИЯ выгрузки (где .git), а
# CONFIG_SUBDIR — где внутри лежит сама конфигурация (Configuration.xml):
#
#   клон ubd_for_ai из GitLab:   WORKSPACE_DIR=D:/work/ubd_for_ai
#                                CONFIG_SUBDIR=src
#   своя выгрузка + git init:    WORKSPACE_DIR=D:/work/my_config
#                                CONFIG_SUBDIR=src
#   выгрузка без git (как было): WORKSPACE_DIR=D:/work/dump
#                                CONFIG_SUBDIR=
#
# Раскладка и зачем git — README, «Обновление выгрузки».
WORKSPACE_DIR=./workspace
CONFIG_SUBDIR=
# SRC-5. Как граф узнаёт об изменениях выгрузки:
#   auto   — git, если в WORKSPACE_DIR есть репозиторий, иначе legacy;
#   git    — только git (без репозитория — ошибка, а не тихий откат);
#   legacy — прежний способ: отпечатки (путь, размер, mtime) обходом.
SOURCE_MODE=auto
# HELP-COPY. Каталог bin установленной платформы 1С, откуда
# scripts/fetch_platform_help.py копирует русскую справку (*_ru.hbk) в
# ./platform-help-data. Нужен только этому скрипту на хосте, в контейнеры
# не передаётся. Пусто — самая новая версия в C:\Program Files\1cv8.
# Можно указать и каталог версии, и корень 1cv8. Пример:
#   ONEC_BIN_DIR=C:\Program Files\1cv8\8.3.27.1606\bin
ONEC_BIN_DIR=
BSL_LS_JAR=/opt/bsl-language-server/bsl-ls.jar
JAVA_OPTS=-Xmx1g
# PERF-9: поднимать JVM фоном при старте контейнера. Первая проверка агента
# иначе платит ~14 секунд тишины, а агент за это время успевает решить, что
# инструмент не отвечает, и ответить по памяти. false вернёт ленивый старт.
BSL_WARMUP=true
# PERF-7: быстрый путь — долгоживущий BSL LS вместо запуска JVM на каждый
# вызов. auto — пробовать и при неудаче уходить на --analyze (умолчание),
# on — только быстрый путь, off — только прежний.
BSL_LSP_MODE=auto

# ─── Набор диагностик BSL (CFG-4) ──────────────────────────────────
# Файл настроек BSL Language Server. Каталог ./bsl-config монтируется в
# контейнер :ro, поэтому правка правил стоит `docker compose restart
# mcp-bsl-checker`, а не пересборки образа.
#
# Пустое значение BSL_LS_CONFIG = работать набором диагностик по
# умолчанию. Что применено на самом деле — bsl_stats, секция config:
# там же лежит fingerprint файла. Если после правки правил отпечаток не
# изменился, контейнер читает старый файл.
#
# ⚠️ Корень конфигурации ищется ОТНОСИТЕЛЬНО анализируемого каталога
# (/data/1c-src), а не относительно файла настроек. Не нашёлся — BSL LS
# молчит, а диагностики по метаданным не работают. CFG-7: параметр
# configurationRoot убран из bsl-config (выгрузка лежит в корне тома);
# проверка осталась и на незаданный параметр — bsl_stats,
# config.configuration_root_check.resolves.
BSL_CONFIG_DIR=./bsl-config
BSL_LS_CONFIG=/app/bsl-config/bsl-language-server.json
# true — отвечать отказом (answerable: false), если свой набор правил не
# применился, вместо тихой проверки набором по умолчанию. Продолжение
# A-5: «проверил не тем набором» — не успех.
BSL_LS_CONFIG_STRICT=false

# ─── Журнал вызовов на время ручного прогона (EVAL-7) ──────────────
# Пусто (по умолчанию) — журнала нет, серверы говорят об этом в логе
# при старте. Включают его на время прогона evals/manual-prompts.md,
# чтобы отметка «обязано быть вызвано» перестала быть догадкой по тексту
# ответа: один вызов со всем списком кодов и пять вызовов подряд
# выглядят на экране одинаково.
#
# Два пути, потому что серверов две породы: четыре своих пишут модулем
# tool_journal.py, пятый (v8std) чужой и пишет своим ключом --usage-log.
# Формат строки общий, читает обе половины scripts/journal_report.py.
#
# После правки — docker compose up -d --force-recreate <серверы>:
# restart не подхватывает ни новый образ, ни новые переменные.
MCP_TOOL_JOURNAL=
V8STD_USAGE_LOG=
# Заполненный вид:
#   MCP_TOOL_JOURNAL=/journal/calls.jsonl
#   V8STD_USAGE_LOG=/journal/v8std.jsonl

# ─── Набор инструментов (TOOL-1, SEC-5, SEC-6) ─────────────────────
# core — рабочий набор под три задачи плана (по умолчанию)
# full — ничего не резать, старое поведение
MCP_TOOL_PROFILE=core
# metadata_reload выполняет MATCH (n) DETACH DELETE n без подтверждения.
ALLOW_DESTRUCTIVE_TOOLS=0
# metadata_cypher — произвольный Cypher; защита чёрным списком подстрок
# обходится и ложно срабатывает на n.offset / n.created.
ALLOW_RAW_CYPHER=0
# metadata_upsert_file / metadata_remove_file — служебные, их вызывает
# workspace-watcher. Выключать только вместе с watcher'ом.
ENABLE_WATCH_TOOLS=1

# ─── Транспорт (TR-4) ──────────────────────────────────────────────
# Защита от DNS rebinding. Разрешённые Host собираются автоматически:
# 127.0.0.1:<порт>, localhost:<порт>, <имя_сервиса>:<порт>.
# Если клиент шлёт другой Host и получает 400/421 — либо добавьте его
# в MCP_ALLOWED_HOSTS, либо временно поставьте 0.
MCP_DNS_REBINDING_PROTECTION=1
MCP_ALLOWED_HOSTS=

# ─── Индексация метаданных (Заход 4, блок A) ───────────────────────
# Форс переиндексации. METADATA_FORCE_REINDEX гонит обе фазы; на боевой
# конфигурации это 28 минут на слой 1 даже тогда, когда правили только
# парсер BSL. CFG-3: с тех пор фазы форсируются раздельно.
#   METADATA_FORCE_XML=true  — переиндексировать слой 1 (XML-метаданные).
#                              Тянет за собой и фазу 2: очистка слоя 1
#                              сносит :Module-узлы, без фазы 2 слой кода
#                              останется пустым.
#   METADATA_FORCE_BSL=true  — переиндексировать только слой 2 (код).
#                              Это то, что нужно после правки парсера
#                              или резолвера.
METADATA_FORCE_REINDEX=false
METADATA_FORCE_XML=false
METADATA_FORCE_BSL=false

# PERF-3. Как считать fingerprint выгрузки, чтобы понять, менялось ли что-то.
#   false (умолчание) — по кортежу (путь, размер, mtime). Секунды.
#   true              — по sha256 содержимого. Прежнее поведение: на 56 410
#                       файлах и 1,2 ГБ это 12 минут ПРИ КАЖДОМ старте.
# Включать строгий режим стоит там, где mtime мог соврать: копирование
# выгрузки утилитой, сохраняющей время, переключение ветки git, любое
# «а точно ли индексер увидел мою правку». Смена режима один раз вызывает
# переиндексацию — значения, посчитанные разными способами, несравнимы,
# и индексер честно пишет об этом в лог.
METADATA_FINGERPRINT_STRICT=false

# PERF-7. Ранний останов фикс-пойнта резолва (фаза 2).
# Боевой прогон 11.08.2026: 8 итераций, 5,3 часа, при этом число
# разрешённых вызовов замерло на третьей итерации (428 918), а итерации
# 4-8 не разрешили ни одного нового вызова за 3,5 часа. Прежний критерий
# смотрел на рост реестров типов, а не на прирост результата.
#   METADATA_FIXPOINT_MIN_GAIN_PCT — процент прироста, ниже которого
#       продолжать не окупается. 1.0 останавливает после 3-й итерации.
#       0 возвращает прежнее поведение — крутить до предела.
#   METADATA_MAX_ITERATIONS — жёсткий потолок, страховка от патологий.
METADATA_FIXPOINT_MIN_GAIN_PCT=1.0
METADATA_MAX_ITERATIONS=8

# PERF-15. Параллельный разбор и резолв BSL (фаза 2): процессы внутри
# одного контейнера, результат тот же, что в один процесс.
#   auto — min(4, ядер − 1); число — ровно столько; 1 — прежний путь.
# Каждый процесс получает модули и индекс без копирования (fork), но то,
# что он насоздаёт за проход, — своё: на боевой выгрузке закладывайте
# ~1 ГБ на процесс сверх обычного. На Docker Desktop 12 ядер / 11,5 ГБ
# 4 процесса проходят с запасом.
METADATA_WORKERS=auto

# PERF-13. Замеры фазы 2 — для решения, что ускорять дальше.
#   METADATA_GC_FREEZE=true — после разбора «заморозить» модули для сборщика
#       мусора: он перестанет пересматривать их на каждой полной сборке.
#       Сравнивайте «gc N%» в строках прогресса резолва с false и с true.
#   METADATA_PROFILE=true — после резолва вывести в лог 30 самых тяжёлых
#       функций. Резолв на это время идёт в один процесс — дольше.
METADATA_GC_FREEZE=false
METADATA_PROFILE=false

# ─── Watcher ───────────────────────────────────────────────────────
# Главный выключатель. По умолчанию false: граф обновляется вручную —
#   .\scripts\graph-refresh.ps1   (Linux: make graph-refresh)
#   или metadata_refresh() из чата.
# true — раз в SOURCE_POLL_SEC watcher делает то же самое сам. После
# правки: docker compose up -d --no-deps --force-recreate workspace-watcher
#
# HYG-7, история. В режиме poll (выгрузка без git) включённый watcher
# дорог: события ФС с диска Windows в контейнер не доходят, и каждый цикл
# опроса = полный обход выгрузки. Замер 12 августа: время fingerprint
# удвоилось (14,1 минуты против 3,3–7,3), 6,2 % CPU в простое. В режиме
# git такт читает только .git — держать его включённым дёшево.
WATCHER_ENABLED=false
# auto — git, если выгрузка в git-репозитории, иначе poll; git | poll.
WATCHER_MODE=auto
# Режим git: интервал такта, секунды (30…3600). 60 — раз в минуту,
# 300 — раз в 5 минут. Вне диапазона контейнер не стартует.
SOURCE_POLL_SEC=60
# Ночная сверка (git status: правки, о которых никто не сообщил), «ЧЧ:ММ»
# по TZ. Пусто — только по флагу needs_reconcile (после полной индексации).
SOURCE_RECONCILE_AT=
# Сверять сразу после полной индексации (флаг needs_reconcile). false —
# если сверка на вашей выгрузке идёт дольше 15 минут: тогда только по
# расписанию выше и вручную (graph-refresh.ps1 -Reconcile).
SOURCE_RECONCILE_ON_FLAG=true
# Плановая полная индексация, «день ЧЧ:ММ» (sat 02:00 / сб 02:00).
# Пусто — выключена. Сбрасывает долг частичных обновлений.
SOURCE_FULL_REINDEX_AT=
# true — watcher сам запускает полную индексацию, когда частичной не
# обойтись (needs_full). По умолчанию только напоминает в логе и в
# metadata_stats: два часа без ведома человека — не умолчание.
SOURCE_AUTO_FULL=false
# Часовой пояс для расписаний watcher'а, например Asia/Vladivostok.
TZ=UTC
# Режим poll: интервал опроса файлов, секунды.
WATCHER_POLLING_INTERVAL=10
# true — опрос (обязательно для Windows/Docker Desktop);
# false — нативные события ФС, только если выгрузка на Linux-хосте/в WSL2 ext4.
WATCHER_USE_POLLING=true
# Инкрементальный апдейт графа Neo4j (.bsl -> call graph, .xml -> схема)
METADATA_WATCH_ENABLED=true
# HYG-4: переменной CODE_WATCH_ENABLED больше нет. Она включала фанаут в
# mcp-code-rag, а сервер удалён из проекта в Заходе 2. Строку в своём .env
# можно убрать — она ни на что не влияет.

# ─── Стандарты разработки v8std (STD-4) ────────────────────────────
# Сервер v8std-mcp читает корпус из ./v8std-data (наполняется командой
# `python3 scripts/fetch_v8std.py`). Секретов не требует.
#
# 1 — если корпуса нет, взять индекс с v8std.ru при старте (нужна сеть);
# 0 — не стартовать без локального корпуса, падать с кодом 78.
V8STD_ALLOW_REMOTE_INDEX=1
# DEBUG/INFO/WARNING/ERROR — по умолчанию WARNING, чтобы не засорять логи.
V8STD_MCP_LOG_LEVEL=WARNING

# ─── Токен 1С:Напарник ─────────────────────────────────────────────
# Сервер mcp-1c-naparnik выключен (профиль extra). Оставлено на случай
# возврата; см. открытый вопрос 1 в PLAN.md — кандидат на удаление.
ONEC_AI_TOKEN=
