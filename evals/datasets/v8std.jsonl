// Датасет для сервера v8std (STD-6). Формат — ../schema.md.
//
// Прогон:  python3 scripts/eval.py --dataset evals/datasets/v8std.jsonl
// Сервер подставится сам (см. DATASET_SERVER в scripts/eval.py).
//
// Почему он появился ВМЕСТЕ с подключением сервера, а не после.
// PLAN-4 §EVAL-1 зафиксировал правило: пока нет измерения, новую
// функциональность не добавляем. Пятый сервер это правило нарушал бы —
// поэтому датасет здесь. Он маленький и меряет ровно одно: достаёт ли
// агент нужный пункт стандарта за один-два вызова.
//
// Про жёсткость проверок. Точное попадание id требуется только там, где
// эталон однозначен: запрос по номеру, по коду диагностики, ловушка на
// несуществующий стандарт. На «человеческих» формулировках стоит
// non_empty в hard, а ожидаемый std — в soft: у чужого поиска своя
// выдача, и ловить на ней регрессы нашего кода бессмысленно.

// ───────── v8std_get_page: точная выдача по номеру ─────────
{"id":"std-001","tool":"v8std_get_page","args":{"id_or_alias_or_url":"std783"},"expect":{"hard":[{"type":"field_equals","path":"found","value":true},{"type":"field_equals","path":"page.id","value":"std783"}],"soft":[{"type":"path_non_empty","path":"page.body"}]},"notes":"Транзакции: правила использования. Главный сценарий — агент увидел номер в правиле или в перекрёстной ссылке и достаёт текст без семантики."}
{"id":"std-002","tool":"v8std_get_page","args":{"id_or_alias_or_url":"std499"},"expect":{"hard":[{"type":"field_equals","path":"found","value":true},{"type":"field_equals","path":"page.id","value":"std499"}],"soft":[]},"notes":"Перехват исключений в коде — на него ссылается .cursor/rules/bsl-code.mdc"}
{"id":"std-003","tool":"v8std_get_page","args":{"id_or_alias_or_url":"std455"},"expect":{"hard":[{"type":"field_equals","path":"found","value":true},{"type":"field_equals","path":"page.id","value":"std455"}],"soft":[]},"notes":"Структура модуля"}

// ───────── ловушка: стандарта нет ─────────
{"id":"std-004","tool":"v8std_get_page","args":{"id_or_alias_or_url":"std999"},"expect":{"hard":[{"type":"field_equals","path":"found","value":false}],"soft":[]},"notes":"Правильный ответ — «такого нет». Если тут когда-нибудь окажется found:true, значит поиск подсунул похожее вместо честного отказа, и агент начнёт цитировать чужой стандарт как запрошенный."}

// ───────── v8std_search: по номеру ─────────
{"id":"std-005","tool":"v8std_search","args":{"query":"std437","limit":5},"expect":{"hard":[{"type":"non_empty"},{"type":"name_in_top_k","k":3,"values":["std437"]}],"soft":[]},"notes":"Оформление текстов запросов. Номер в запросе — эталон однозначен, держим в hard."}
{"id":"std-006","tool":"v8std_search","args":{"query":"std460","limit":5},"expect":{"hard":[{"type":"non_empty"},{"type":"name_in_top_k","k":3,"values":["std460"]}],"soft":[]},"notes":"Использование управляемого режима блокировки"}

// ───────── v8std_search: формулировкой, без номера ─────────
{"id":"std-007","tool":"v8std_search","args":{"query":"что делать с транзакцией при исключении","limit":10},"expect":{"hard":[{"type":"non_empty"}],"soft":[{"type":"name_in_top_k","k":5,"values":["std783","std499"]}]},"notes":"Ровно тот вопрос, ради которого всё затевалось: агент знает симптом, не знает номера."}
{"id":"std-008","tool":"v8std_search","args":{"query":"модальные окна","limit":10},"expect":{"hard":[{"type":"non_empty"}],"soft":[{"type":"name_in_top_k","k":5,"values":["std703","bslls:UsingModalWindows"]}]},"notes":"Пример из документации самого v8std — ожидаем std703 либо диагностику."}
{"id":"std-009","tool":"v8std_search","args":{"query":"как называть переменные","limit":10},"expect":{"hard":[{"type":"non_empty"}],"soft":[{"type":"name_in_top_k","k":5,"values":["std454","std647"]}]},"notes":"Правила образования имён переменных / имена процедур и функций"}
{"id":"std-010","tool":"v8std_search","args":{"query":"чтение одного реквизита объекта вместо ПолучитьОбъект","limit":10},"expect":{"hard":[{"type":"non_empty"}],"soft":[{"type":"name_in_top_k","k":5,"values":["std496","std648"]}]},"notes":"Проверяет, что поиск переживает имена методов платформы внутри русской фразы."}

// ───────── v8std_explain_diagnostics: мост от bsl-checker (STD-5) ─────────
{"id":"std-011","tool":"v8std_explain_diagnostics","args":{"codes":["bslls:UsingModalWindows"]},"expect":{"hard":[{"type":"path_non_empty","path":"diagnostics"},{"type":"path_non_empty","path":"standards"}],"soft":[]},"notes":"Ровно то, что отдаёт bsl_check_code в std_lookup.codes. Если standards пуст — мост есть, но никуда не ведёт."}
{"id":"std-012","tool":"v8std_explain_diagnostics","args":{"codes":["acc:1245"]},"expect":{"hard":[{"type":"path_non_empty","path":"diagnostics"}],"soft":[{"type":"path_non_empty","path":"standards"}]},"notes":"Код АПК — второе пространство диагностик, приходит не от BSL LS, а из отчёта проверки конфигурации."}
{"id":"std-013","tool":"v8std_explain_diagnostics","args":{"codes":["bslls:НетТакойДиагностики"]},"expect":{"hard":[{"type":"path_non_empty","path":"unknown_codes"}],"soft":[{"type":"field_equals","path":"unique_codes","value":1}]},"notes":"Вторая ловушка: несуществующий код должен попасть в unknown_codes, а не молча исчезнуть из ответа."}

// ───────── v8std_get_related: переход стандарт → диагностика ─────────
{"id":"std-014","tool":"v8std_get_related","args":{"id_or_alias_or_url":"std783","limit":10},"expect":{"hard":[{"type":"field_equals","path":"found","value":true}],"soft":[{"type":"path_non_empty","path":"related"}]},"notes":"Инструмента такого в PLAN-STD не было — меряем, стоит ли о нём вообще говорить агенту в правилах."}

// ───────── v8std_explain_snippet: подбор по коду ─────────
{"id":"std-015","tool":"v8std_explain_snippet","args":{"snippet":"НачатьТранзакцию();\nДокументОбъект.Записать();\nЗафиксироватьТранзакцию();","language":"bsl","limit":10},"expect":{"hard":[],"soft":[{"type":"path_non_empty","path":"standards"},{"type":"name_in_top_k","k":5,"values":["std783"]}]},"notes":"Транзакция без Попытка. Hard пуст намеренно: подбор по сниппету эвристический, и падающий hard тут говорил бы не о регрессе, а о переобучении датасета. ВАЖНО: на публичный ai.v8std.ru закрытый код так слать нельзя — этот инструмент и есть причина держать сервер локально."}
