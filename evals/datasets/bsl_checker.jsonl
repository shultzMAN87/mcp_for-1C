// Датасет для bsl-checker (FIX-9). Формат — ../schema.md.
//
// Прогон:  python3 scripts/eval.py --dataset evals/datasets/bsl_checker.jsonl
//
// Зачем он появился. Инструмент bsl_check_* не был покрыт измерением ни
// одним примером — и из-за этого дефект дожил до первой живой проверки:
// анализатор запускался с несуществующим ключом --src, находил ноль
// файлов, отчёт искался под чужим именем, а ответ был «ошибок не найдено».
// Три ошибки подряд, и все три невидимы, пока никто не спросит у
// инструмента заведомо плохой код.
//
// Отсюда главный принцип этого файла: проверяем не только «находит
// замечания», но и «не выдаёт тишину за чистоту».

// ───────── заведомо плохой код: замечания обязаны быть ─────────
{"id":"bsl-001","tool":"bsl_check_code","args":{"code":"Процедура ЗаписатьДанные(ДокументОбъект)\n\tНачатьТранзакцию();\n\tДокументОбъект.Записать();\n\tЗафиксироватьТранзакцию();\nКонецПроцедуры\n"},"expect":{"hard":[{"type":"field_equals","path":"status","value":"issues_found"},{"type":"path_non_empty","path":"diagnostics"}],"soft":[{"type":"path_non_empty","path":"std_lookup.codes"}]},"notes":"Транзакция без Попытка — ровно тот фрагмент, на котором инструмент молча отвечал ok. Если здесь снова status=ok, дефект вернулся."}
{"id":"bsl-002","tool":"bsl_check_code","args":{"code":"Процедура Тест()\n\tПопытка\n\t\tВыполнить(\"Сообщить(1)\");\n\tИсключение\n\tКонецПопытки;\nКонецПроцедуры\n"},"expect":{"hard":[{"type":"field_equals","path":"status","value":"issues_found"},{"type":"path_non_empty","path":"diagnostics"}],"soft":[{"type":"path_non_empty","path":"std_lookup.codes"}]},"notes":"Пустой блок Исключение плюс Выполнить со строкой — std499 и std770."}

// ───────── мост к стандартам (STD-5) ─────────
{"id":"bsl-003","tool":"bsl_check_code","args":{"code":"Процедура ЗаписатьДанные(ДокументОбъект)\n\tНачатьТранзакцию();\n\tДокументОбъект.Записать();\n\tЗафиксироватьТранзакцию();\nКонецПроцедуры\n"},"expect":{"hard":[{"type":"path_non_empty","path":"std_lookup.codes"},{"type":"field_equals","path":"std_lookup.tool","value":"v8std_explain_diagnostics"}],"soft":[]},"notes":"Коды должны быть в форме bslls:<Имя> и передаваться в v8std одним вызовом. Проверяет STD-5 на стыке, а не на глаз."}

// ───────── чистый код: ложных срабатываний быть не должно ─────────
{"id":"bsl-004","tool":"bsl_check_code","args":{"code":"// Возвращает сумму двух чисел.\n//\n// Параметры:\n//  Первое - Число - первое слагаемое.\n//  Второе - Число - второе слагаемое.\n//\n// Возвращаемое значение:\n//  Число - сумма.\n//\nФункция Сложить(Первое, Второе) Экспорт\n\tВозврат Первое + Второе;\nКонецФункции\n"},"expect":{"hard":[],"soft":[{"type":"field_equals","path":"status","value":"ok"}]},"notes":"Hard пуст намеренно: набор диагностик по умолчанию может придраться к чему угодно, и жёсткая проверка тут ловила бы не регресс, а смену версии BSL LS. Но если status=issues_found — стоит посмотреть, на что именно."}

// ───────── ловушка: отказ анализатора не должен выглядеть как чистота ─────────
{"id":"bsl-005","tool":"bsl_check_file","args":{"file_path":"/data/1c-src/заведомо-нет-такого-файла.bsl"},"expect":{"hard":[{"type":"path_non_empty","path":"error"}],"soft":[]},"notes":"Вторая половина FIX-9: любой отказ обязан приезжать полем error, а не пустым списком диагностик. Именно неразличимость этих двух случаев и скрывала дефект."}
