# ── Секреты и локальная конфигурация ─────────────────────────────────
# .env.* закрывает и .env.local, и .env.prod, и .env.backup — такие файлы
# заводятся на автомате и утекают легче всего. Шаблоны возвращаем явно:
# они должны быть в репозитории, чтобы после клонирования было с чего
# начинать.
.env
.env.*
!.env.example
.cursor/mcp.json
*.lic

# ── Данные, которых не должно быть в репозитории ─────────────────────
# Выгрузка конфигурации 1С — не наш код.
/workspace/*
!/workspace/.gitkeep
!/workspace/AGENTS.md

# Справка платформы — проприетарные файлы 1С, 40+ МБ.
# Берутся из bin\conf установленной платформы, см. README.
/platform-help-data/*
!/platform-help-data/.gitkeep
!/platform-help-data/README*

# Чужой корпус стандартов (STD-1), забирается scripts/fetch_v8std.py.
# Лицензия CC0, но это чужие данные и 10+ МБ, а версия и так фиксируется
# в v8std-data/FETCH.json.
/v8std-data/

# Отчёты прогонов измерений. Растут с каждым прогоном и попадают в
# коммиты пачками, а нужны только локально: `eval_all.py` и
# `soft_misses.py` сравнивают по каталогу, гит им не нужен. Сам каталог
# оставляем — в него пишет eval.py через bind-volume.
/evals/reports/*
!/evals/reports/.gitkeep

# EVAL-7: журналы вызовов ручного прогона. Относятся к одному прогону,
# копия нужного куска живёт в его бланке (docs/archive/ПРОГОН-AGENT-*.md).
# Каталог оставляем — в него пишут пять контейнеров через bind-volume.
/evals/journal/*
!/evals/journal/README.md

# ── Локальные окружения и артефакты ──────────────────────────────────
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.log
.pytest_cache/
.idea/
.vscode/
.DS_Store
*.swp
